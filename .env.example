# --- Local demo (no accounts, data kept in memory; only works with `npm run dev`) ---
# NEXT_PUBLIC_APP_MODE=demo
# NEXT_PUBLIC_DEMO_LOCAL_ONLY=true

# --- Production ---
NEXT_PUBLIC_APP_MODE=production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# AI tailoring: set ONE of these keys. "auto" picks whichever key is present.
TAILORING_PROVIDER=auto
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Payments (Dodo Payments) — https://app.dodopayments.com
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Server-only: lets the payment webhook update subscriptions. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
