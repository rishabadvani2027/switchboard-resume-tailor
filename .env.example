# --- Local demo (no accounts, data kept in memory; only works with `npm run dev`) ---
# NEXT_PUBLIC_APP_MODE=demo
# NEXT_PUBLIC_DEMO_LOCAL_ONLY=true

# --- Production ---
NEXT_PUBLIC_APP_MODE=production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# AI tailoring: set ONE of these keys. "auto" picks whichever key is present.
TAILORING_PROVIDER=auto
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
